{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MK-56 Assembly",
  "scopeName": "source.mk56asm",
  "fileTypes": [
    "asm",
    "mk56"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#listing"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.mk56asm",
          "begin": ";",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.test.mk56asm",
              "match": "@(angle|reg|stack|start|input|run|expect|reset)\\b"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.mk56asm",
          "match": "//.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "constant.numeric.address.mk56asm",
          "match": "(?<![^\\s])[0-9]{1,2}:"
        },
        {
          "name": "entity.name.function.label.mk56asm",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*):"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.mk56asm",
          "match": "(?i)\\.(ORG|END|LISTING|ASM|STEP|EQU|ASSERT|TRACE|BREAK)\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.mk56asm",
          "match": "(?i)\\b(ADD|SUB|MUL|DIV|CHS|SQRT|SQ|INV|POW|EXP10|EXP|LN|LOG|PI)\\b"
        },
        {
          "name": "keyword.operator.trig.mk56asm",
          "match": "(?i)\\b(SIN|COS|TAN|ASIN|ACOS|ATAN)\\b"
        },
        {
          "name": "keyword.control.stack.mk56asm",
          "match": "(?i)\\b(ENTER|SWAP|ROT|ROLLDOWN|CLX|LASTX|EEX)\\b"
        },
        {
          "name": "keyword.control.memory.mk56asm",
          "match": "(?i)\\b(STO|RCL)\\b"
        },
        {
          "name": "keyword.control.flow.mk56asm",
          "match": "(?i)\\b(JMP|GOTO|CALL|RTN|RETURN|HALT|STOP|NOP|JZ|JNZ|JLT|JGE|LOOP[0-3])\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.mk56asm",
          "match": "(?i)\\(?\\bR[0-9A-D]\\b\\)?"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mk56asm",
          "match": "(?<![\\w.])-?[0-9]+([.,][0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "listing": {
      "patterns": [
        {
          "name": "keyword.control.flow.mk56asm",
          "match": "(К\\s?)?(БП|ПП|В/[ОO0]|С/П|C/П)|К\\s?НОП|F\\s?L[0-3]|F\\s?x(≠|!=|≥|>=|<|=)0|Кx(≠|≥|<|=)0"
        },
        {
          "name": "keyword.control.memory.mk56asm",
          "match": "К?(ИП|П)(?=\\s?[0-9a-dа-д]\\b)|x→П|П→x"
        },
        {
          "name": "keyword.operator.function.mk56asm",
          "match": "F\\s?(10ˣ|eˣ|lg|ln|sin⁻¹|cos⁻¹|tg⁻¹|sin|cos|tg|π|√|x²|1/x|xʸ|⟳|Bx|,)"
        },
        {
          "name": "keyword.operator.mk56asm",
          "match": "В↑|↑|↔|ВП|Cx|Сx|/-/|/−/|[+−×÷]"
        }
      ]
    }
  }
}